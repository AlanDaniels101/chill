{
    /* Visit https://firebase.google.com/docs/database/security to learn more about security rules. */
    "rules": {
      "users": {
        "$uid": {
          "name": {
            ".read": "auth !== null"
          },
          // Readable by others so avatars can render next to names
          "profileImage": {
            ".read": "auth !== null"
          },
          // Users can read and write their own data
          ".read": "$uid === auth.uid",
          ".write": "$uid === auth.uid"
        }
      },
      "groups": {
        "$groupId": {
          // Readable by any signed-in user, not just members, because the join
          // flows read the group (name, existence, own membership) before the
          // user belongs to it. Reading is no more permissive than joining,
          // which any signed-in user with the group id can already do.
          ".read": "auth !== null",
           ".write": "auth !== null && (
            // CREATION
            (!data.exists() && newData.exists()) ||
            
            // UPDATE
            (data.exists() && newData.exists() && (
              // Admins can update anything
              data.child('admins').child(auth.uid).val() === true)) ||
             
            // DELETION
            (data.exists() && !newData.exists() &&
              // Must be an admin to delete the group
              data.child('admins').child(auth.uid).val() === true)
          )",
          ".validate": "newData.hasChildren(['name', 'members', 'admins'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length > 0"
          },
          "createdAt": {
            ".validate": "newData.isNumber()"
          },
          "members": {
            ".validate": "newData.hasChildren()",
            "$uid": {
              ".validate": "newData.isBoolean()",
              // Only allow writing to members if user is an admin of the group, or a user adding themselves
              ".write": "auth !== null && (auth.uid === $uid || data.parent().parent().child('admins').child(auth.uid).val() === true)"
            }
          },
          "admins": {
            ".validate": "newData.hasChildren()",
            "$uid": {
              ".validate": "newData.isBoolean()",
              // Only admins can modify admin status
              ".write": "auth != null && (data.parent().parent().child('admins').child(auth.uid).val() === true)"
            }
          },
          "hangouts": {
             "$hangoutId": {
              ".validate": "newData.isBoolean()",
              // Only group members can add hangouts
              ".write": "auth !== null && data.parent().parent().child('members').child(auth.uid).val() === true"
            }
          }
        }
      },
      "hangouts": {
        ".read": false,
        "$hangoutId": {
          "group": {
            ".read": "auth != null",
            ".write": false
          },
          // First read the group ID from the hangout data
          // Then check if the user is a member/admin of that group
          ".read": "auth !== null && 
            data.exists() && 
            data.child('group').exists() && 
            (
              root.child('groups').child(data.child('group').val()).child('members').child(auth.uid).val() === true ||
              root.child('groups').child(data.child('group').val()).child('admins').child(auth.uid).val() === true
            )",
          // Parent writes are limited to create and delete; field updates use child rules below.
          ".write": "auth !== null && (
            // CREATION
            (!data.exists() && newData.exists() &&
              root.child('groups').child(newData.child('group').val()).child('members').child(auth.uid).val() === true) ||
            
            // DELETION
            (data.exists() && !newData.exists() &&
              data.child('createdBy').val() === auth.uid)
          )",
          "createdBy": {
            ".write": false
          },
          "createdAnonymously": {
            ".write": false
          },
          "name": {
            ".write": "auth !== null && (
              root.child('groups').child(data.parent().child('group').val()).child('members').child(auth.uid).val() === true ||
              root.child('groups').child(data.parent().child('group').val()).child('admins').child(auth.uid).val() === true
            )"
          },
          "info": {
            ".write": "auth !== null && (
              root.child('groups').child(data.parent().child('group').val()).child('members').child(auth.uid).val() === true ||
              root.child('groups').child(data.parent().child('group').val()).child('admins').child(auth.uid).val() === true
            )"
          },
          "durationMinutes": {
            ".write": "auth !== null && (
              root.child('groups').child(data.parent().child('group').val()).child('members').child(auth.uid).val() === true ||
              root.child('groups').child(data.parent().child('group').val()).child('admins').child(auth.uid).val() === true
            )"
          },
          "location": {
            ".write": "auth !== null && (
              root.child('groups').child(data.parent().child('group').val()).child('members').child(auth.uid).val() === true ||
              root.child('groups').child(data.parent().child('group').val()).child('admins').child(auth.uid).val() === true
            )"
          },
          "time": {
            ".write": "auth !== null && (
              root.child('groups').child(data.parent().child('group').val()).child('members').child(auth.uid).val() === true ||
              root.child('groups').child(data.parent().child('group').val()).child('admins').child(auth.uid).val() === true
            )"
          },
          "minAttendees": {
            ".write": "auth !== null && (
              root.child('groups').child(data.parent().child('group').val()).child('members').child(auth.uid).val() === true ||
              root.child('groups').child(data.parent().child('group').val()).child('admins').child(auth.uid).val() === true
            )"
          },
          "maxAttendees": {
            ".write": "auth !== null && (
              root.child('groups').child(data.parent().child('group').val()).child('members').child(auth.uid).val() === true ||
              root.child('groups').child(data.parent().child('group').val()).child('admins').child(auth.uid).val() === true
            )"
          },
          "datetimePollInProgress": {
            ".write": "auth !== null && (
              root.child('groups').child(data.parent().child('group').val()).child('members').child(auth.uid).val() === true ||
              root.child('groups').child(data.parent().child('group').val()).child('admins').child(auth.uid).val() === true
            )"
          },
          "candidateDates": {
            ".write": "auth !== null && (
              root.child('groups').child(data.parent().child('group').val()).child('members').child(auth.uid).val() === true ||
              root.child('groups').child(data.parent().child('group').val()).child('admins').child(auth.uid).val() === true
            )"
          },
          "datePollSelections": {
            ".write": "auth !== null && (
              root.child('groups').child(data.parent().child('group').val()).child('members').child(auth.uid).val() === true ||
              root.child('groups').child(data.parent().child('group').val()).child('admins').child(auth.uid).val() === true
            )",
            "$uid": {
              ".write": "auth !== null && (
                root.child('groups').child(data.parent().parent().child('group').val()).child('members').child(auth.uid).val() === true ||
                root.child('groups').child(data.parent().parent().child('group').val()).child('admins').child(auth.uid).val() === true
              )"
            }
          },
          "attendees": {
            "$uid": {
              // Users can only modify their own attendance
              ".write": "auth !== null && $uid === auth.uid"
            }
          }
        }
      }
    }
  }